{
  "name": "repo-template-react-tanstack",
  "description": "Repository template for TanStack Start, React 19, Tailwind v4, and Biome.",
  "author": "Molly Thompson",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    }
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/typography": "^0.5.4",
    "@tanstack/devtools-vite": "^0.8.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,json,html}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
